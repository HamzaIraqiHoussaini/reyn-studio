{
  "schema": "com.reyn.cad-bridge.protocol/1",
  "transport": "length_prefixed_json_stdio",
  "byte_order": "little_endian_u32_payload_length",
  "max_request_bytes": 67108864,
  "max_response_bytes": 268435456,
  "timeout_ms_default": 120000,
  "requests": {
    "hello": {
      "required": ["schema", "op", "request_id"],
      "op": "hello"
    },
    "list_occurrences": {
      "required": ["schema", "op", "request_id", "path"],
      "op": "list_occurrences"
    },
    "tessellate_step": {
      "required": [
        "schema",
        "op",
        "request_id",
        "path",
        "chord_tolerance",
        "max_triangles",
        "max_shells"
      ],
      "op": "tessellate_step",
      "optional": ["occurrence_path", "unit_hint"]
    },
    "cancel": {
      "required": ["schema", "op", "request_id", "target_request_id"],
      "op": "cancel"
    }
  },
  "responses": {
    "hello_ok": {
      "required": ["schema", "ok", "op", "request_id", "bridge_version", "occt_version"]
    },
    "occurrences_ok": {
      "required": [
        "schema",
        "ok",
        "op",
        "request_id",
        "assembly",
        "occurrences"
      ],
      "occurrence_fields": ["path", "name", "transform_4x4"]
    },
    "mesh_ok": {
      "required": [
        "schema",
        "ok",
        "op",
        "request_id",
        "length_unit",
        "shell_count",
        "triangle_count",
        "positions_f32le_b64",
        "indices_u32le_b64",
        "tessellation_param_sha256",
        "warnings"
      ],
      "optional": [
        "face_identity_kind",
        "triangle_face_ids_u32le_b64",
        "occurrence_path",
        "occurrence_transform_4x4"
      ]
    },
    "error": {
      "required": ["schema", "ok", "op", "request_id", "code", "message"],
      "ok": false,
      "codes": [
        "unsupported_assembly",
        "occurrence_required",
        "occurrence_not_found",
        "ambiguous_face_identity",
        "timeout",
        "memory_limit",
        "malformed_step",
        "unsupported_surface",
        "cancelled",
        "internal"
      ]
    }
  },
  "fail_closed": [
    "assemblies without explicit occurrence_path",
    "unknown occurrence_path",
    "bridge panic or non-zero exit",
    "payload over max_*_bytes",
    "unknown op",
    "silent remap of boundary assignments without evidence-safe face identity"
  ],
  "licensing": {
    "studio": "Apache-2.0 / MIT Rust host; never statically links OCCT",
    "bridge": "separate process; dynamically linked OCCT with LGPL notices"
  }
}
